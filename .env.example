APP_NAME=DeepCheck
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Porta em que a aplicação fica exposta no host (http://localhost:APP_PORT)
APP_PORT=8080

# O container do MySQL sobe totalmente vazio, só com o usuário root (definido
# abaixo). Banco, usuário de aplicação e tabelas são criados manualmente pelo
# MySQL Workbench, conectando como root em localhost:DB_EXPOSED_PORT.
DB_ROOT_PASSWORD=changeme_root

# Porta exposta no host para conectar via MySQL Workbench (localhost:DB_EXPOSED_PORT).
# Usa 3307 por padrão para não conflitar com um MySQL/XAMPP já instalado na máquina.
DB_EXPOSED_PORT=3307

# Preencha estes 3 valores DEPOIS de criar o banco e o usuário de aplicação
# pelo Workbench — são os dados que o config/conexao.php usa para conectar.
# DB_HOST deve continuar "db" (nome do serviço no docker-compose), não
# "localhost", pois é assim que o container da aplicação enxerga o do banco
# pela rede interna do Docker.
DB_HOST=db
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# E-mail do sistema (envio das Não Conformidades)
# ------------------------------------------------------------------------------
# O DeepCheck envia as NCs por UMA conta de e-mail do sistema. Cada e-mail sai
# com o nome de quem enviou ("Fulano via DeepCheck"), com "Responder para" e
# cópia (CC) no e-mail do usuário, então as respostas chegam direto a ele.
# NUNCA commite a senha real: ela fica só no .env (que está no .gitignore).
#
# SMTP_SEGURANCA aceita: starttls (porta 587), ssl (porta 465) ou nenhuma.
#
# --- DESENVOLVIMENTO (padrão): Mailpit, o "pega-e-mails" do docker-compose ---
# Nenhum e-mail é entregue de verdade: todos aparecem em
# http://localhost:8025 (ou na porta de MAILPIT_PORT). Use estes valores
# enquanto estiver desenvolvendo/testando.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SEGURANCA=nenhuma
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=deepcheck@localhost
EMAIL_REMETENTE_NOME=DeepCheck
#
# --- PRODUÇÃO com Gmail (envio real) ---
# 1. Crie a conta Gmail do sistema (ex.: nome-da-conta@gmail.com).
# 2. Ative a "Verificação em duas etapas" nessa conta.
# 3. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#    (16 letras). Use ESSA senha abaixo, não a senha normal da conta.
# 4. Troque os valores de desenvolvimento acima por:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_SEGURANCA=starttls
#      SMTP_USUARIO=nome-da-conta@gmail.com
#      SMTP_SENHA=abcdefghijklmnop
#      EMAIL_REMETENTE=nome-da-conta@gmail.com
#      EMAIL_REMETENTE_NOME=DeepCheck
# O Gmail exige que EMAIL_REMETENTE seja a própria conta de SMTP_USUARIO.

# Porta da interface web do Mailpit no host (http://localhost:MAILPIT_PORT).
MAILPIT_PORT=8025
