APP_NAME=DeepCheck
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Porta em que a aplicação fica exposta no host (http://localhost:APP_PORT)
APP_PORT=8080

# O container do MySQL sobe totalmente vazio, só com o usuário root (definido
# abaixo). Banco, usuário de aplicação e tabelas são criados manualmente pelo
# MySQL Workbench, conectando como root em localhost:DB_EXPOSED_PORT.
DB_ROOT_PASSWORD=changeme_root

# Porta exposta no host para conectar via MySQL Workbench (localhost:DB_EXPOSED_PORT).
# Usa 3307 por padrão para não conflitar com um MySQL/XAMPP já instalado na máquina.
DB_EXPOSED_PORT=3307

# Preencha estes 3 valores DEPOIS de criar o banco e o usuário de aplicação
# pelo Workbench — são os dados que o config/conexao.php usa para conectar.
# DB_HOST deve continuar "db" (nome do serviço no docker-compose), não
# "localhost", pois é assim que o container da aplicação enxerga o do banco
# pela rede interna do Docker.
DB_HOST=db
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
